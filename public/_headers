# Response headers for Cloudflare Pages, which serves the static site at bartaboard.com
# (public/.htaccess does the same job on Apache / LiteSpeed hosts). Pages already sends HTML and
# JSON with "max-age=0, must-revalidate", so each visit checks for newer headlines.

/*
  X-Content-Type-Options: nosniff

# Next writes the share image and the home-screen icon without a file extension.
/opengraph-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png

# Scripts, styles and fonts are named after their contents, so a file never changes at its address.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Outlets' logos keep their address when they change (at most weekly, see scripts/fetch-news.ts).
# They are third-party files served from this site: one opened directly must not run scripts.
/logos/*
  Cache-Control: public, max-age=86400
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox
/brand/*
  Cache-Control: public, max-age=86400
